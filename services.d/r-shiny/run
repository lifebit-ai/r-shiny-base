#!/usr/bin/with-contenv sh

# R Shiny Application Service
# Runs as rshiny user (UID/GID 1000)
#
# SHINY_APP_PATH: relative path to app within /opt/shiny-apps (e.g., "myapp" or "apps/dashboard")
#
# Usage in derived Dockerfile:
#   FROM rshiny-base
#   COPY ./my-shiny-app /opt/shiny-apps/myapp
#   ENV SHINY_APP_PATH=myapp

echo "Starting R Shiny Application..."

# App path relative to /opt/shiny-apps (default: "demo")
SHINY_APP_PATH="${SHINY_APP_PATH:-demo}"
FULL_APP_PATH="/opt/shiny-apps/${SHINY_APP_PATH}"

echo "App directory: ${FULL_APP_PATH}"
echo "Port: 8787"
echo "User: rshiny"

cd "${FULL_APP_PATH}" || { echo "ERROR: Cannot access ${FULL_APP_PATH}"; exit 1; }

# Run Shiny app as rshiny user using s6-setuidgid
exec s6-setuidgid rshiny Rscript -e "shiny::runApp(host='0.0.0.0', port=8787)"
